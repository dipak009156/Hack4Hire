# ==============================================================================
# QUANTUM-LOCK Production Environment Variables
# ==============================================================================

# Database Credentials
POSTGRES_DB=quantumlock
POSTGRES_USER=qluser
POSTGRES_PASSWORD=qlpass_secure_production_password

# Object Store (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_production_password

# Message Broker (RabbitMQ)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest_secure_production_password

# Platform Administration & Onboarding Email
PlatformMail=chavandipak0606@gmail.com
PLATFORM_MAIL=chavandipak0606@gmail.com
PLATFORM_BASE_URL=http://localhost:3000

# Transactional SMTP Settings (Brevo / Sendinblue recommended: 300 free/day)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASS=your-brevo-smtp-key

# JWT Signing Secret (must be at least 256 bits / 32 characters)
JWT_SECRET=replace-with-a-very-long-production-cryptographic-secret-key-at-least-256-bits

# Frontend Port
FRONTEND_PORT=3000

